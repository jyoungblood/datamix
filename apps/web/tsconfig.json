{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "paths": {
      "@/*": ["./src/*"]
    },
    "rootDir": ".",
    "types": ["node"],
    "tsBuildInfoFile": "./tsconfig.tsbuildinfo"
  },
  "include": [
    ".astro/types.d.ts",
    "src/**/*.astro",
    "src/**/*.css",
    "src/**/*.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "worker-configuration.d.ts"
  ],
  "exclude": ["dist"]
}
