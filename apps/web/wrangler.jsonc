{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Top-level config is the local development contract.
  // Replace the placeholder IDs and example domains before real preview/production deploys.
  "name": "datamix-app-dev",
  "main": "worker/index.ts",
  "compatibility_date": "2026-05-06",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "APP_ENV": "development",
    "APP_ORIGIN": "http://127.0.0.1:3000",
    "MEDIA_PUBLIC_ORIGIN": "http://127.0.0.1:3000",
    "AUTH_EMAIL_PROVIDER": "resend",
    "AUTH_EMAIL_FROM_EMAIL": "noreply@example.com",
    "AUTH_EMAIL_FROM_NAME": "Datamix",
    "AUTH_EMAIL_REPLY_TO_EMAIL": "support@example.com",
    "AUTH_SMTP_HOST": "smtp.example.com",
    "AUTH_SMTP_PORT": "587",
    "AUTH_SMTP_TLS": "starttls",
    "PUBLIC_API_READ_ACCESS": "public",
    "PUBLIC_API_WRITE_ACCESS": "disabled"
  },
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "images": {
    "binding": "IMAGES"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "datamix-local",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "preview_database_id": "datamix-local",
      "migrations_dir": "../../drizzle/d1"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "datamix-media-local",
      "preview_bucket_name": "datamix-media-local"
    }
  ],
  "env": {
    "preview": {
      "name": "datamix-app-preview",
      "vars": {
        "APP_ENV": "preview",
        "APP_ORIGIN": "https://preview.datamix.example",
        "MEDIA_PUBLIC_ORIGIN": "https://preview.datamix.example",
        "AUTH_EMAIL_PROVIDER": "resend",
        "AUTH_EMAIL_FROM_EMAIL": "noreply@example.com",
        "AUTH_EMAIL_FROM_NAME": "Datamix",
        "AUTH_EMAIL_REPLY_TO_EMAIL": "support@example.com",
        "AUTH_SMTP_HOST": "smtp.example.com",
        "AUTH_SMTP_PORT": "587",
        "AUTH_SMTP_TLS": "starttls",
        "PUBLIC_API_READ_ACCESS": "public",
        "PUBLIC_API_WRITE_ACCESS": "disabled"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "datamix-preview",
          "database_id": "11111111-1111-1111-1111-111111111111",
          "migrations_dir": "../../drizzle/d1"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA_BUCKET",
          "bucket_name": "datamix-media-preview",
          "preview_bucket_name": "datamix-media-preview"
        }
      ]
    },
    "production": {
      "name": "datamix-app",
      "vars": {
        "APP_ENV": "production",
        "APP_ORIGIN": "https://datamix.example",
        "MEDIA_PUBLIC_ORIGIN": "https://datamix.example",
        "AUTH_EMAIL_PROVIDER": "resend",
        "AUTH_EMAIL_FROM_EMAIL": "noreply@example.com",
        "AUTH_EMAIL_FROM_NAME": "Datamix",
        "AUTH_EMAIL_REPLY_TO_EMAIL": "support@example.com",
        "AUTH_SMTP_HOST": "smtp.example.com",
        "AUTH_SMTP_PORT": "587",
        "AUTH_SMTP_TLS": "starttls",
        "PUBLIC_API_READ_ACCESS": "public",
        "PUBLIC_API_WRITE_ACCESS": "disabled"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "datamix-production",
          "database_id": "22222222-2222-2222-2222-222222222222",
          "migrations_dir": "../../drizzle/d1"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA_BUCKET",
          "bucket_name": "datamix-media-production",
          "preview_bucket_name": "datamix-media-production"
        }
      ]
    }
  }
}
