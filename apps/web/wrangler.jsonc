{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Top-level config is the deployed Datamix app contract.
  // Local development overrides runtime values from apps/web/.dev.vars.
  "name": "datamix-app",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-05-06",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "APP_ENV": "production",
    "APP_ORIGIN": "https://datamix.example",
    "MEDIA_PUBLIC_ORIGIN": "https://datamix.example",
    "NEXT_PUBLIC_APP_ENV": "production",
    "NEXT_PUBLIC_APP_ORIGIN": "https://datamix.example",
    "AUTH_EMAIL_PROVIDER": "resend",
    "AUTH_EMAIL_FROM_EMAIL": "noreply@example.com",
    "AUTH_EMAIL_FROM_NAME": "Datamix",
    "AUTH_EMAIL_REPLY_TO_EMAIL": "support@example.com",
    "AUTH_SMTP_HOST": "smtp.example.com",
    "AUTH_SMTP_PORT": "587",
    "AUTH_SMTP_TLS": "starttls",
    "PUBLIC_API_READ_ACCESS": "public",
    "PUBLIC_API_WRITE_ACCESS": "disabled"
  },
  "assets": {
    "directory": "dist",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "datamix-db",
      "database_id": "22222222-2222-2222-2222-222222222222",
      "migrations_dir": "../../drizzle/d1"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "datamix-media"
    }
  ]
}
