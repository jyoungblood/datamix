---
import { datamixProduct } from "@datamix/core";

import DatamixRootLayout from "../layouts/DatamixRootLayout.astro";
---

<DatamixRootLayout>
  <main
    class="flex min-h-svh items-center justify-center bg-[var(--muted)] px-6 py-8"
    data-page-canvas="muted"
  >
    <div class="text-center">
      <p class="text-sm font-semibold uppercase tracking-wide text-muted-foreground">
        {datamixProduct.name}
      </p>
      <h1 class="mt-3 text-3xl font-bold text-foreground">Page not found</h1>
      <a
        class="mt-6 inline-flex text-sm font-medium text-primary underline-offset-4 hover:underline"
        href="/admin"
      >
        Open admin
      </a>
    </div>
  </main>
</DatamixRootLayout>
