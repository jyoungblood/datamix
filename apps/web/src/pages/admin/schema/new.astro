---
import { adminRoutes } from "@/admin/_workspace/admin-routes";
import SchemaBuilderRouteBody from "@/components/admin/SchemaBuilderRouteBody.astro";
import AdminWorkspaceShell from "@/components/admin/AdminWorkspaceShell.astro";
import { resolveSchemaBuilderPage } from "@/server/routes/astro-admin-stateful-pages";

import DatamixRootLayout from "../../../layouts/DatamixRootLayout.astro";

const route = adminRoutes.schema.new();
const page = await resolveSchemaBuilderPage(Astro.request, route);

if (page.kind === "redirect") {
  return Astro.redirect(page.location);
}
---

<DatamixRootLayout>
  <AdminWorkspaceShell {...page.shell}>
    {
      page.workspace ? (
        <SchemaBuilderRouteBody
          collectionLoadError={page.schemaBuilder.collectionLoadError}
          collections={page.schemaBuilder.collections}
          collectionsLoaded={page.schemaBuilder.collectionsLoaded}
          mode="create"
          routeAccess={page.workspace.routeAccess}
          workspace={page.workspace}
        />
      ) : null
    }
  </AdminWorkspaceShell>
</DatamixRootLayout>
