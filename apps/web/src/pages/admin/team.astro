---
import { adminRoutes } from "@/admin/_workspace/admin-routes";
import TeamRouteBody from "@/components/admin/TeamRouteBody.astro";
import AdminWorkspaceShell from "@/components/admin/AdminWorkspaceShell.astro";
import { resolveTeamPage } from "@/server/routes/astro-admin-stateful-pages";

import DatamixRootLayout from "../../layouts/DatamixRootLayout.astro";

const route = adminRoutes.team();
const page = await resolveTeamPage(Astro.request, route);

if (page.kind === "redirect") {
  return Astro.redirect(page.location);
}
---

<DatamixRootLayout>
  <AdminWorkspaceShell {...page.shell}>
    {
      page.workspace ? (
        <TeamRouteBody
          roles={page.team.roles}
          rolesLoadError={page.team.rolesLoadError}
          rolesLoaded={page.team.rolesLoaded}
          routeAccess={page.workspace.routeAccess}
          users={page.team.users}
          usersLoadError={page.team.usersLoadError}
          usersLoaded={page.team.usersLoaded}
          workspace={page.workspace}
        />
      ) : null
    }
  </AdminWorkspaceShell>
</DatamixRootLayout>
