---
import { adminRoutes } from "@/admin/_workspace/admin-routes";
import MediaLibraryRouteBody from "@/components/admin/MediaLibraryRouteBody.astro";
import AdminWorkspaceShell from "@/components/admin/AdminWorkspaceShell.astro";
import { resolveMediaLibraryPage } from "@/server/routes/astro-admin-stateful-pages";

import DatamixRootLayout from "../../layouts/DatamixRootLayout.astro";

const route = adminRoutes.media();
const page = await resolveMediaLibraryPage(Astro.request, route);

if (page.kind === "redirect") {
  return Astro.redirect(page.location);
}
---

<DatamixRootLayout>
  <AdminWorkspaceShell {...page.shell}>
    {
      page.workspace ? (
        <MediaLibraryRouteBody
          mediaAssets={page.mediaLibrary.mediaAssets}
          mediaAssetsLoaded={page.mediaLibrary.mediaAssetsLoaded}
          mediaLoadError={page.mediaLibrary.mediaLoadError}
          routeAccess={page.workspace.routeAccess}
          workspace={page.workspace}
        />
      ) : null
    }
  </AdminWorkspaceShell>
</DatamixRootLayout>
