---
import AuthCard from "@/components/auth/AuthCard.astro";
import {
  readLocalNextPath,
  resolveLoginPageState,
} from "@/server/routes/astro-auth-page";

import DatamixRootLayout from "../../layouts/DatamixRootLayout.astro";

const result = await resolveLoginPageState(Astro.request, Astro.url);

if ("redirect" in result) {
  return Astro.redirect(result.redirect);
}

const { state } = result;
const enabledOAuthProviders = state.oauthProviders.filter((provider) => provider.enabled);
const nextPath = readLocalNextPath(Astro.url);
const prefillEmail = Astro.url.searchParams.get("email") ?? "";
const setupStatusHeading =
  state.setupStatusCode === 503
    ? "Auth config is incomplete"
    : "Datamix is temporarily unavailable";
const setupRecoveryCopy =
  state.setupStatusCode === 503
    ? "Set BETTER_AUTH_SECRET on the Datamix Worker, then reload this page."
    : "Reload this page when the Worker app is reachable again.";

function readOAuthErrorMessage(url: URL) {
  const error = url.searchParams.get("error");

  if (!error) {
    return null;
  }

  switch (error) {
    case "signup_disabled":
      return "OAuth sign-in is enabled, but Datamix still requires an existing or invited account. Ask an administrator for an invite first.";
    case "account_not_linked":
      return "Datamix found your email, but this social account could not be linked automatically. Try password sign-in first, then retry OAuth.";
    case "unable_to_link_account":
      return "Datamix could not link that social account. Make sure the invited email matches, or sign in with your password first.";
    case "oauth_provider_not_found":
      return "That OAuth provider is not enabled on this Datamix instance.";
    case "invalid_code":
      return "The OAuth handoff expired or was rejected. Try the sign-in button again.";
    case "email_not_found":
      return "The OAuth provider did not return an email address, so Datamix could not finish signing you in.";
    default:
      return url.searchParams.get("error_description") ?? "Datamix could not complete the OAuth sign-in.";
  }
}

const oauthErrorMessage = readOAuthErrorMessage(Astro.url);
const alertClass =
  "group/alert relative grid w-full gap-0.5 rounded-lg border px-4 py-3 text-left text-sm bg-card text-destructive";
const alertDescriptionClass = "text-sm text-balance text-destructive/90 md:text-pretty";
const buttonBaseClass =
  "inline-flex h-9 shrink-0 items-center justify-center gap-1.5 whitespace-nowrap rounded-md border border-transparent bg-clip-padding px-2.5 text-sm font-medium transition-all outline-none select-none focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 active:not-aria-[haspopup]:translate-y-px disabled:pointer-events-none disabled:opacity-50";
const buttonClass = `${buttonBaseClass} bg-primary text-primary-foreground hover:bg-primary/80`;
const outlineButtonClass = `${buttonBaseClass} border-border bg-background shadow-xs hover:bg-muted hover:text-foreground`;
const inputClass =
  "h-9 w-full min-w-0 rounded-md border border-input bg-transparent px-2.5 py-1 text-base shadow-xs transition-[color,box-shadow] outline-none placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 disabled:pointer-events-none disabled:cursor-not-allowed disabled:opacity-50 md:text-sm dark:bg-input/30";
const labelClass = "text-sm font-medium leading-none";
---

<DatamixRootLayout>
  {
    state.setupError ? (
      <AuthCard
        description={state.setupError}
        label="Authentication"
        title={setupStatusHeading}
      >
        <div class={alertClass} role="alert">
          <div class={alertDescriptionClass}>{setupRecoveryCopy}</div>
        </div>
        <div class="flex flex-wrap gap-3">
          <a class={outlineButtonClass} href="/">Back home</a>
        </div>
      </AuthCard>
    ) : (
      <AuthCard
        description="This instance already has an admin account, so Datamix is using the standard sign-in flow."
        label="Authentication"
        title="Sign in to Datamix"
      >
        <div data-auth-page="login" data-next-path={nextPath}>
          {enabledOAuthProviders.length > 0 ? (
            <div class="space-y-3">
              <p class="text-sm text-muted-foreground">
                Optional OAuth is enabled for existing or invited Datamix users.
              </p>
              <div class="grid gap-2">
                {enabledOAuthProviders.map((provider) => (
                  <button
                    class={outlineButtonClass}
                    data-auth-provider={provider.id}
                    data-auth-provider-label={provider.label}
                    type="button"
                  >
                    Continue with {provider.label}
                  </button>
                ))}
              </div>
              <div class="relative">
                <div class="absolute inset-0 flex items-center">
                  <div class="w-full shrink-0 border-t border-border"></div>
                </div>
                <div class="relative flex justify-center">
                  <span class="bg-card px-2 text-xs uppercase text-muted-foreground">
                    Or continue with email
                  </span>
                </div>
              </div>
            </div>
          ) : null}

          <form class="mt-6 space-y-4">
            <div class="grid gap-2">
              <label class={labelClass} for="email">Email</label>
              <input
                autocomplete="email"
                class={inputClass}
                id="email"
                required
                type="email"
                value={prefillEmail}
              />
            </div>

            <div class="grid gap-2">
              <label class={labelClass} for="password">Password</label>
              <input
                autocomplete="current-password"
                class={inputClass}
                id="password"
                minlength="8"
                required
                type="password"
              />
            </div>

            <div
              class={alertClass}
              data-auth-error
              hidden={!oauthErrorMessage}
              role="alert"
            >
              <div class={alertDescriptionClass} data-auth-error-message>
                {oauthErrorMessage}
              </div>
            </div>

            <a
              class="inline-block text-sm text-muted-foreground underline-offset-4 hover:underline"
              href="/admin/forgot-password"
            >
              Forgot your password?
            </a>

            <div class="flex flex-wrap gap-3">
              <a class={outlineButtonClass} href="/">Back home</a>
              <button class={buttonClass} type="submit">Sign in</button>
            </div>
          </form>
        </div>
      </AuthCard>
    )
  }

  <script>
    import "@/scripts/admin-auth/login";
  </script>
</DatamixRootLayout>
