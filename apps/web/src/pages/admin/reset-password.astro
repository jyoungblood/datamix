---
import AuthCard from "@/components/auth/AuthCard.astro";

import DatamixRootLayout from "../../layouts/DatamixRootLayout.astro";

const token = Astro.url.searchParams.get("token") ?? "";
const email = Astro.url.searchParams.get("email") ?? "";
const mode = Astro.url.searchParams.get("mode") === "invite" ? "invite" : "reset";
const error = Astro.url.searchParams.get("error") ?? "";
const title = mode === "invite" ? "Accept your invite" : "Choose a new password";
const description =
  mode === "invite"
    ? "Set your password to finish joining this Datamix instance."
    : "Choose a new password for your Datamix account.";
const loginHref = email
  ? `/admin/login?email=${encodeURIComponent(email)}`
  : "/admin/login";
const initialErrorMessage =
  error === "INVALID_TOKEN" ? "This reset link is invalid or has expired." : null;
const alertClass =
  "group/alert relative grid w-full gap-0.5 rounded-lg border px-4 py-3 text-left text-sm bg-card text-destructive";
const alertDescriptionClass = "text-sm text-balance text-destructive/90 md:text-pretty";
const successAlertClass =
  "group/alert relative grid w-full gap-0.5 rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-left text-sm text-emerald-950";
const successDescriptionClass = "text-sm text-balance text-emerald-800 md:text-pretty";
const buttonBaseClass =
  "inline-flex h-9 shrink-0 items-center justify-center gap-1.5 whitespace-nowrap rounded-md border border-transparent bg-clip-padding px-2.5 text-sm font-medium transition-all outline-none select-none focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 active:not-aria-[haspopup]:translate-y-px disabled:pointer-events-none disabled:opacity-50";
const buttonClass = `${buttonBaseClass} bg-primary text-primary-foreground hover:bg-primary/80`;
const outlineButtonClass = `${buttonBaseClass} border-border bg-background shadow-xs hover:bg-muted hover:text-foreground`;
const inputClass =
  "h-9 w-full min-w-0 rounded-md border border-input bg-transparent px-2.5 py-1 text-base shadow-xs transition-[color,box-shadow] outline-none placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 disabled:pointer-events-none disabled:cursor-not-allowed disabled:opacity-50 md:text-sm dark:bg-input/30";
const labelClass = "text-sm font-medium leading-none";
---

<DatamixRootLayout>
  <AuthCard description={description} label="Authentication" title={title}>
    <div class={successAlertClass} data-auth-success hidden role="status">
      <div class={successDescriptionClass}>
        Sign in with your new password to continue.
      </div>
      <div class="mt-3">
        <a class={buttonClass} href={loginHref}>Go to login</a>
      </div>
    </div>

    <form class="space-y-4" data-auth-page="reset-password">
      <input id="token" type="hidden" value={token} />

      <div class="grid gap-2">
        <label class={labelClass} for="new-password">New password</label>
        <input
          autocomplete="new-password"
          class={inputClass}
          id="new-password"
          minlength="8"
          required
          type="password"
        />
      </div>

      <div class="grid gap-2">
        <label class={labelClass} for="confirm-password">Confirm password</label>
        <input
          autocomplete="new-password"
          class={inputClass}
          id="confirm-password"
          minlength="8"
          required
          type="password"
        />
      </div>

      <div
        class={alertClass}
        data-auth-error
        hidden={!initialErrorMessage}
        role="alert"
      >
        <div class={alertDescriptionClass} data-auth-error-message>
          {initialErrorMessage}
        </div>
      </div>

      <div class="flex flex-wrap gap-3">
        <a class={outlineButtonClass} href="/admin/login">Back to login</a>
        <button class={buttonClass} type="submit">
          {mode === "invite" ? "Set password and continue" : "Reset password"}
        </button>
      </div>
    </form>
  </AuthCard>

  <script>
    import "@/scripts/admin-auth/reset-password";
  </script>
</DatamixRootLayout>
