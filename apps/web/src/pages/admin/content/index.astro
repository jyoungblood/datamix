---
import ContentIndexRouteBody from "@/components/admin/ContentIndexRouteBody.astro";
import AdminWorkspaceShell from "@/components/admin/AdminWorkspaceShell.astro";
import { resolveContentIndexPage } from "@/server/routes/astro-admin-content-index-page";

import DatamixRootLayout from "../../../layouts/DatamixRootLayout.astro";

const page = await resolveContentIndexPage(Astro.request);

if (page.kind === "redirect") {
  return Astro.redirect(page.location);
}
---

<DatamixRootLayout>
  <AdminWorkspaceShell {...page.shell}>
    {
      page.workspace ? (
        <ContentIndexRouteBody
          collectionLoadError={page.contentIndex.collectionLoadError}
          collections={page.contentIndex.collections}
          recordLoadError={page.contentIndex.recordLoadError}
          recordRows={page.contentIndex.recordRows}
          routeAccess={page.workspace.routeAccess}
          workspace={page.workspace}
        />
      ) : null
    }
  </AdminWorkspaceShell>
</DatamixRootLayout>
