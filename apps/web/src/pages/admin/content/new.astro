---
import { adminRoutes } from "@/admin/_workspace/admin-routes";
import ContentEditorRouteBody from "@/components/admin/ContentEditorRouteBody.astro";
import AdminWorkspaceShell from "@/components/admin/AdminWorkspaceShell.astro";
import { resolveContentEditorPage } from "@/server/routes/astro-admin-stateful-pages";

import DatamixRootLayout from "../../../layouts/DatamixRootLayout.astro";

const route = adminRoutes.content.newRecord();
const selectedSchemaId =
  Astro.url.searchParams.get("schemaId")?.trim() || undefined;
const page = await resolveContentEditorPage(Astro.request, route, {
  schemaId: selectedSchemaId,
});

if (page.kind === "redirect") {
  return Astro.redirect(page.location);
}
---

<DatamixRootLayout>
  <AdminWorkspaceShell {...page.shell}>
    {
      page.workspace ? (
        <ContentEditorRouteBody
          collectionLoadError={page.contentEditor.collectionLoadError}
          collections={page.contentEditor.collections}
          collectionsLoaded={page.contentEditor.collectionsLoaded}
          mediaAssets={page.contentEditor.mediaAssets}
          mediaAssetsLoaded={page.contentEditor.mediaAssetsLoaded}
          mediaLoadError={page.contentEditor.mediaLoadError}
          mode="create"
          recordLoadError={page.contentEditor.recordLoadError}
          recordSupportedFieldNames={page.contentEditor.recordSupportedFieldNames}
          records={page.contentEditor.records}
          recordsLoaded={page.contentEditor.recordsLoaded}
          routeAccess={page.workspace.routeAccess}
          schemaId={selectedSchemaId}
          workspace={page.workspace}
        />
      ) : null
    }
  </AdminWorkspaceShell>
</DatamixRootLayout>
