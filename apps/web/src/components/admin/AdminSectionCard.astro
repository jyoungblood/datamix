---
type Props = {
  class?: string;
  description?: string;
  title?: string;
};

const { class: className, description, title } = Astro.props;
const hasAction = Astro.slots.has("action");
const hasHeader = Boolean(title || description || hasAction);
---

<section
  class:list={[
    "group/card flex flex-col gap-6 overflow-hidden rounded-lg border-border bg-white py-6 text-sm text-card-foreground shadow-none ring-1 ring-foreground/10 has-[>img:first-child]:pt-0 *:[img:first-child]:rounded-t-xl *:[img:last-child]:rounded-b-xl",
    className,
  ]}
  data-slot="card"
>
  {
    hasHeader ? (
      <header
        class="group/card-header @container/card-header grid auto-rows-min items-start gap-1 rounded-t-xl px-6"
        data-slot="card-header"
      >
        <div class="flex items-start justify-between gap-3">
          <div class="min-w-0">
            {title ? (
              <h2
                class="font-heading text-lg leading-normal font-medium text-slate-950"
                data-slot="card-title"
              >
                {title}
              </h2>
            ) : null}
            {description ? (
              <p class="mt-1 text-xs leading-5 text-muted-foreground" data-slot="card-description">
                {description}
              </p>
            ) : null}
          </div>
          {
            hasAction ? (
              <div class="shrink-0">
                <slot name="action" />
              </div>
            ) : null
          }
        </div>
      </header>
    ) : null
  }
  <div class="px-6" data-slot="card-content">
    <slot />
  </div>
</section>
