---
type AdminStateBoxTone = "error" | "neutral" | "success" | "warning";

type Props = {
  body: string;
  class?: string;
  compact?: boolean;
  title: string;
  tone?: AdminStateBoxTone;
};

const {
  body,
  class: className,
  compact = false,
  title,
  tone = "neutral",
} = Astro.props;
const role = tone === "error" ? "alert" : "status";
const hasAction = Astro.slots.has("action");
---

<div
  class:list={[
    "empty-state-box state-box",
    `state-box-${tone}`,
    compact && "compact-box",
    className,
  ]}
  role={role}
>
  <p class="list-title">{title}</p>
  <p class="list-copy">{body}</p>
  {
    hasAction ? (
      <div class="state-box-actions">
        <slot name="action" />
      </div>
    ) : null
  }
</div>
