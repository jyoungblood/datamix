---
import {
  SchemaBuilderFormIsland,
  SchemaBuilderSaveButtonIsland,
} from "@/admin/_screens/schema-builder";
import { AdminWorkspaceCommandPalette } from "@/admin/_workspace/admin-command-palette";
import type { AdminWorkspaceRouteAccessState } from "@/admin/_workspace/admin-permissions";
import { adminRoutes } from "@/admin/_workspace/admin-routes";
import type { AdminWorkspaceProps } from "@/admin/_workspace/admin-workspace-props";
import { buttonVariants } from "@/components/ui/button";
import type { StoredCollectionDefinition } from "@/server/collections";

import AdminPageHeader from "./AdminPageHeader.astro";
import AdminSectionCard from "./AdminSectionCard.astro";
import AdminStateBox from "./AdminStateBox.astro";

type Props = {
  collectionLoadError: string | null;
  collections: StoredCollectionDefinition[];
  collectionsLoaded: boolean;
  mode: "create" | "edit";
  routeAccess: AdminWorkspaceRouteAccessState;
  schemaId?: string;
  workspace: AdminWorkspaceProps;
};

const {
  collectionLoadError,
  collections,
  collectionsLoaded,
  mode,
  routeAccess,
  schemaId,
  workspace,
} = Astro.props;

const { permissions } = workspace;
const isEditingExistingSchema = mode === "edit";
const schemaIndexHref = adminRoutes.schema.index().href;
const schemaIndexButtonClass = buttonVariants({ variant: "outline" });

function decodeSchemaId(value: string) {
  try {
    return decodeURIComponent(value);
  } catch {
    return value;
  }
}

const decodedSchemaId = schemaId ? decodeSchemaId(schemaId) : null;
const activeCollection =
  isEditingExistingSchema && decodedSchemaId !== null
    ? collections.find((collection) => collection.id === decodedSchemaId) ?? null
    : null;
const canSaveCurrentSchema = isEditingExistingSchema
  ? permissions.canUpdateCollections
  : permissions.canCreateCollections;
const shouldBlockSchemaUntilLoaded =
  isEditingExistingSchema &&
  permissions.canViewCollections && !collectionsLoaded && !collectionLoadError;
const pageTitle =
  mode === "create"
    ? "New schema"
    : shouldBlockSchemaUntilLoaded
      ? "Schema"
      : activeCollection
        ? `${activeCollection.definition.label} schema`
        : "Schema";
const shouldRenderSchemaBuilderForm =
  routeAccess.isAllowed &&
  (!isEditingExistingSchema ||
    (permissions.canViewCollections &&
      !shouldBlockSchemaUntilLoaded &&
      !(collectionLoadError && collections.length === 0) &&
      !(collectionsLoaded && activeCollection === null)));
const schemaDetailsDescription = isEditingExistingSchema
  ? "The schema name is the stable storage identifier."
  : "Name the schema before saving it.";
const schemaReadOnlyBody = isEditingExistingSchema
  ? "Your current role can view this schema, but it cannot save schema changes."
  : "Your current role cannot create schemas.";
const staleSchemaListBody =
  collectionLoadError && collections.length > 0
    ? `${collectionLoadError} You can keep editing the current draft with the last saved schema list that loaded.`
    : null;
---

<div class="mx-auto flex w-full max-w-6xl flex-col gap-4">
  <div class="flex justify-end">
    <AdminWorkspaceCommandPalette client:only="react" workspace={workspace} />
  </div>

  <AdminPageHeader title={pageTitle}>
    <Fragment slot="action">
      <div class="flex flex-wrap gap-2">
        <a class={schemaIndexButtonClass} href={schemaIndexHref}>All schemas</a>
        <SchemaBuilderSaveButtonIsland
          client:only="react"
          canSave={canSaveCurrentSchema}
          mode={mode}
        />
      </div>
    </Fragment>
  </AdminPageHeader>

  {
    !routeAccess.isAllowed ? (
      <AdminStateBox body={routeAccess.body} title={routeAccess.title} tone="warning" />
    ) : isEditingExistingSchema && !permissions.canViewCollections ? (
      <AdminStateBox
        body="Your current role cannot browse saved schemas, so Datamix cannot load this schema for editing."
        title="Schema editing is restricted"
        tone="warning"
      />
    ) : shouldBlockSchemaUntilLoaded ? (
      <AdminStateBox
        body="Loading saved schema details before opening the builder."
        title="Loading schema"
      />
    ) : isEditingExistingSchema &&
      collectionLoadError &&
      collections.length === 0 ? (
      <AdminStateBox
        body={collectionLoadError}
        title="Schema is unavailable"
        tone="error"
      />
    ) : isEditingExistingSchema &&
      collectionsLoaded &&
      activeCollection === null ? (
      <AdminStateBox
        body={`Datamix could not find a saved schema with id ${decodedSchemaId ?? "this route"}.`}
        title="Schema not found"
        tone="warning"
      >
        <Fragment slot="action">
          <a class={schemaIndexButtonClass} href={schemaIndexHref}>Back to schemas</a>
        </Fragment>
      </AdminStateBox>
    ) : shouldRenderSchemaBuilderForm ? (
      <Fragment>
        <form
          class="grid gap-4 lg:grid-cols-[270px_minmax(0,1fr)]"
          id="schema-builder-form"
          onsubmit="return false"
        >
          <aside class="space-y-4">
            <AdminSectionCard
              description={schemaDetailsDescription}
              title="Schema details"
            >
              <div data-schema-builder-region="schema-details"></div>
            </AdminSectionCard>

            <AdminSectionCard
              description="Field order here becomes the generated content editing order."
              title="Fields"
            >
              <div class="space-y-3">
                <div data-schema-builder-region="field-add"></div>
                <div data-schema-builder-region="field-summary"></div>
              </div>
            </AdminSectionCard>
          </aside>

          <AdminSectionCard
            description="Configure labels, API names, required state, and type-specific settings."
            title="Field settings"
          >
            <Fragment slot="action">
              <div data-schema-builder-region="reset-draft"></div>
            </Fragment>

            {!canSaveCurrentSchema ? (
              <AdminStateBox
                body={schemaReadOnlyBody}
                compact
                title="Schema changes are read-only"
                tone="warning"
              />
            ) : null}
            {staleSchemaListBody ? (
              <AdminStateBox
                body={staleSchemaListBody}
                compact
                title="Saved schema list may be out of date"
                tone="warning"
              />
            ) : null}
            <div data-schema-builder-region="schema-status"></div>
            <div data-schema-builder-region="field-settings"></div>
          </AdminSectionCard>
        </form>

        <SchemaBuilderFormIsland
          client:only="react"
          activeCollection={activeCollection}
          canSave={canSaveCurrentSchema}
          mode={mode}
        />
      </Fragment>
    ) : null
  }
</div>
