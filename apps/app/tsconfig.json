{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "paths": {
      "@/*": ["./*"]
    },
    "rootDir": ".",
    "types": ["node"],
    "tsBuildInfoFile": "./tsconfig.tsbuildinfo"
  },
  "include": [
    "app/**/*.tsx",
    "client-pages/**/*.tsx",
    "components/**/*.tsx",
    "lib/**/*.ts",
    "server/**/*.d.ts",
    "server/**/*.ts",
    "styles/**/*.css",
    "types/**/*.d.ts",
    "worker/**/*.ts",
    "worker-configuration.d.ts"
  ]
}
