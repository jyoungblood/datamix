{
  "name": "@datamix/app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/logs vinext dev --hostname 127.0.0.1 --port 3000",
    "build": "vinext build",
    "start": "vinext start",
    "deploy": "npm run build && wrangler deploy --config wrangler.jsonc",
    "deploy:preview": "npm run build && wrangler deploy --config wrangler.jsonc --env preview",
    "deploy:production": "npm run build && wrangler deploy --config wrangler.jsonc --env production",
    "typegen": "WRANGLER_LOG_PATH=.wrangler/logs wrangler types ./worker-configuration.d.ts --config wrangler.jsonc",
    "typecheck": "WRANGLER_LOG_PATH=.wrangler/logs wrangler types ./worker-configuration.d.ts --config wrangler.jsonc --check && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@datamix/core": "0.0.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@tailwindcss/vite": "^4.3.0",
    "@tiptap/core": "^3.22.5",
    "@tiptap/extension-link": "^3.22.5",
    "@tiptap/extension-placeholder": "^3.22.5",
    "@tiptap/markdown": "^3.22.5",
    "@tiptap/react": "^3.22.5",
    "@tiptap/starter-kit": "^3.22.5",
    "better-auth": "^1.6.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.14.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "shadcn": "^4.7.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.39.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitejs/plugin-rsc": "^0.5.27",
    "react-server-dom-webpack": "^19.2.7",
    "vinext": "^0.0.41",
    "vite": "^7.2.2",
    "wrangler": "^4.97.0"
  }
}
