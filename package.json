{
  "name": "datamix",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@11.8.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace @datamix/web",
    "build": "npm run build --workspace @datamix/web",
    "typecheck": "npm run typecheck --workspace @datamix/web",
    "check": "npm run typecheck --workspace @datamix/web",
    "typegen": "npm run typegen --workspace @datamix/web",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate:local": "WRANGLER_LOG_PATH=apps/web/.wrangler/logs wrangler d1 migrations apply DB --local --config apps/web/wrangler.jsonc",
    "db:migrate:remote": "WRANGLER_LOG_PATH=apps/web/.wrangler/logs wrangler d1 migrations apply DB --remote --config apps/web/wrangler.jsonc",
    "smoke": "node --import tsx ./tests/smoke/datamix-smoke.mjs",
    "deploy": "npm run deploy --workspace @datamix/web",
    "clean": "node ./scripts/clean.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
